data/
# Env files and migrate's backups hold password hashes; nothing COPYs them
# today, this keeps a future broad COPY from baking them into a layer.
.env*
*.bak
*.bak.*
.git/
.gitignore
.gitmodules
README.md
docker-compose.yml
node_modules
webmanager/frontend/node_modules
webmanager/frontend/dist
webmanager/backend/webmanager
builds/
dev/
# Former submodule checkouts. They're fetched by tag now, but an existing
# deployment's builds/code-docker can still have these directories on disk after
# the pull that removed them; keep them out of the build context either way.
router/
code-dind/
code-server-autoinstall/
envmigrate/
**/go.work
**/go.work.sum
