{
  "name": "webmanager",
  "displayName": "webmanager",
  "description": "code-docker's webmanager (terminal sessions and every other tab) as editor tabs and bottom-panel views. Built into the code-docker image and synced on every start - see config/code/code-extensions.default.sh.",
  "publisher": "code-docker",
  "version": "0.1.0",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:webmanager.page"
  ],
  "contributes": {
    "viewsContainers": {
      "panel": [
        {
          "id": "webmanager",
          "title": "webmanager",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "webmanager": [
        {
          "type": "webview",
          "id": "webmanager.term1",
          "name": "Terminal 1"
        },
        {
          "type": "webview",
          "id": "webmanager.term2",
          "name": "Terminal 2",
          "when": "webmanager.slot.term2"
        },
        {
          "type": "webview",
          "id": "webmanager.term3",
          "name": "Terminal 3",
          "when": "webmanager.slot.term3"
        },
        {
          "type": "webview",
          "id": "webmanager.term4",
          "name": "Terminal 4",
          "when": "webmanager.slot.term4"
        },
        {
          "type": "webview",
          "id": "webmanager.page1",
          "name": "Page 1",
          "when": "webmanager.slot.page1"
        },
        {
          "type": "webview",
          "id": "webmanager.page2",
          "name": "Page 2",
          "when": "webmanager.slot.page2"
        }
      ]
    },
    "commands": [
