    "configuration": {
      "title": "webmanager",
      "properties": {
        "webmanager.basePath": {
          "type": "string",
          "default": "/manager/",
          "description": "Path webmanager is served at on this code-server's own origin.",
          "scope": "machine"
        },
        "webmanager.internalUrl": {
          "type": "string",
          "default": "",
          "description": "Base URL the extension host uses to list terminal sessions. Empty = http://$WEBMANAGER_ADDR (default private:81).",
          "scope": "machine"
        },
        "webmanager.passthroughKeys": {
          "type": "array",
          "description": "Key chords that leave an embedded webmanager view and run a VS Code command instead. Chord format: modifiers (any order: ctrl, shift, alt, meta), then the key (letters/digits lowercase, f1..f12, pageup, pagedown, `, etc.) - read from the physical key, so keyboard layout doesn't matter.",
          "items": {
            "type": "object",
            "required": [
              "key",
              "command"
            ],
            "properties": {
              "key": {
                "type": "string"
              },
              "command": {
                "type": "string"
              },
              "args": {}
            }
          },
          "default": [
            {
              "key": "ctrl+shift+p",
              "command": "workbench.action.showCommands"
            },
            {
              "key": "f1",
              "command": "workbench.action.showCommands"
            },
            {
              "key": "shift+meta+p",
              "command": "workbench.action.showCommands"
            },
            {
              "key": "ctrl+`",
              "command": "workbench.action.togglePanel"
            },
            {
              "key": "ctrl+pageup",
              "command": "workbench.action.previousEditor"
            },
            {
              "key": "ctrl+pagedown",
              "command": "workbench.action.nextEditor"
            },
            {
              "key": "ctrl+1",
              "command": "workbench.action.focusFirstEditorGroup"
            },
            {
              "key": "ctrl+2",
              "command": "workbench.action.focusSecondEditorGroup"
            },
            {
              "key": "ctrl+3",
              "command": "workbench.action.focusThirdEditorGroup"
            },
            {
              "key": "ctrl+shift+e",
              "command": "workbench.view.explorer"
            }
          ],
          "scope": "machine"
        },
        "webmanager.theme": {
          "type": "string",
          "enum": [
            "auto",
            "light",
            "dark"
          ],
          "enumDescriptions": [
            "Follow the VS Code color theme (light or dark).",
            "Always light.",
            "Always dark."
          ],
          "default": "auto",
          "description": "Theme of the embedded webmanager views. webmanager's own theme toggle lives in its sidebar, which a view doesn't show."
        },
        "webmanager.retainContextWhenHidden": {
          "type": "object",
          "default": {
            "terminal": true,
            "vnc": true,
            "other": false
          },
          "properties": {
            "terminal": {
              "type": "boolean"
            },
            "vnc": {
              "type": "boolean"
            },
            "other": {
              "type": "boolean"
            }
          },
          "description": "Keep a hidden view's page alive. On for terminals and VNC (keeps the connection, scroll position and the session attached - a VNC view that isn't kept reconnects every time it's shown again); off for everything else to save memory. Page slots follow `vnc` as well as `other`, since either can end up showing VNC. Applies to views created after the change (editor tabs) or after a reload (panel slots)."
        }
      }
    }
  }
}
