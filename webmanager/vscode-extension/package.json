      "editor/title": [
        {
          "command": "webmanager.view.switchTab",
          "when": "activeWebviewPanelId == 'webmanager.page'",
          "group": "navigation@0"
        },
        {
          "command": "webmanager.view.moveToPanel",
          "when": "activeWebviewPanelId == 'webmanager.page'",
          "group": "navigation@1"
        },
        {
          "command": "webmanager.view.changeSession",
          "when": "activeWebviewPanelId == 'webmanager.page' && webmanager.activePanelTerminal",
          "group": "1_session@0"
        },
        {
          "command": "webmanager.view.renameSession",
          "when": "activeWebviewPanelId == 'webmanager.page' && webmanager.activePanelSession",
          "group": "1_session@1"
