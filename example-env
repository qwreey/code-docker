# code-docker 컨테이너 자체의 런타임 설정입니다. webmanager(관리자 패널) 설정은
# .env.webmanager로 별도 관리됩니다 - example-env.webmanager 참고.
#
# 이 파일을 .env 로 복사한 뒤 필요한 값만 주석을 풀어 쓰세요. 전부
# docker-compose.yml에 합리적인 기본값이 있어 대부분은 건드릴 필요가 없습니다.
#
#   cp example-env .env
#
# 값을 바꾼 뒤에는 `docker compose up -d`로 컨테이너를 재생성해야 반영됩니다
# (`restart`로는 환경변수 변경이 적용되지 않습니다). 이 파일이 없어도 정상
# 동작합니다(전부 기본값). code-docker 자체의 env 포맷은 webmanager와 달리 자주
# 바뀌지 않으므로, 이 파일엔 .env.webmanager 같은 마이그레이션 도구가 없습니다 -
# 새 키가 생기거나 없어져도 항상 기본값으로 안전하게 떨어집니다.

# 아래 PREFIX/BUILD_CONTEXT/EXTRA_INCLUDE 셋은 컨테이너 안 환경변수가 아니라
# docker-compose.yml 자체(이름 짓기/build.context/include:)에만 쓰입니다.

# 여러 code-docker 인스턴스를 한 호스트에서 띄울 때 container_name/네트워크
# 이름이 겹치지 않도록 붙이는 접두사입니다(예: "foo" -> "foocode-docker", ...).
#PREFIX=""

# docker-compose.yml을 레포지토리 바깥(예: ~/code-docker/)으로 복사해 쓰는
# 경우의 빌드 컨텍스트 경로입니다. 기본값 "."은 이 파일이 레포지토리 바로 안에
# 있다고 가정합니다 - 레포를 builds/code-docker로 클론했다면 docker-compose.yml을
# 직접 고치는 대신 여기서 BUILD_CONTEXT="builds/code-docker"로 지정하세요.
#BUILD_CONTEXT="."

# docker-compose.yml 최상위에 추가로 include할 Compose 파일 경로입니다. 기본값
# "empty-extra-include.yml"은 아무 것도 안 하는 0바이트 빈 파일(레포에 커밋되어
# 있음)이라 안 건드리면 지금까지와 동일하게 동작합니다. 다른 프로젝트를 함께
# 띄우고 싶을 때만, 버전관리 대상이 아닌 자신만의 extra-include.yml을 만들고
# 여기서 그 경로를 가리키세요 - 원본은 건드리지 않으므로 `git pull`과 충돌하지
# 않습니다. 예시는 docs/tips/roblox-studio.md 참고.
#EXTRA_INCLUDE="empty-extra-include.yml"

# EXTRA_INCLUDE로 붙인 프로젝트가 자기만의 `internal: true` 네트워크에 router를 끌어들일
# 때는, code-docker의 .env가 아니라 그 프로젝트 오버레이가 네트워크에 직접
# `netinit.provider`/`netinit.exempt-forward: "true"` 라벨을 답니다 -
# docs/tips/roblox-studio.md 참고.

# netinit-docker 이미지의 build context를 덮어씁니다. 기본값은
# qwreey/router-docker-client의 원격 git URL이라 보통 건드릴 일이 없고, 로컬
# 체크아웃에서 빌드해 시험할 때만 씁니다(예:
# NETINIT_DOCKER_CONTEXT=/path/to/router-docker-client/netinit-docker). 원격 git
# context는 Docker가 캐시하므로, 업스트림 변경을 반영하려면 --no-cache 재빌드가
# 필요할 수 있습니다.
#NETINIT_DOCKER_CONTEXT=""

# qwreey/router-docker-client(netshare, dns-local, netinit-docker)를 어디서
# 가져올지 정하는 *접두사*입니다. 기본값은 원격 git URL이고, 로컬 체크아웃으로
# 개발할 때만 경로를 `/`로 끝나게 적습니다 - 뒤에 하위 디렉터리 이름이 그대로
# 붙습니다. script/dev-clone.sh가 dev/에 clone한 뒤 이 줄을 출력해 줍니다. 위
# NETINIT_DOCKER_CONTEXT가 설정돼 있으면 netinit-docker만은 그쪽이 우선합니다.
#ROUTER_CLIENT_SOURCE="./dev/router-docker-client/"

# 코어 의존물(router-docker, dind-authz-docker, code-server-autoinstall)의 버전
# 핀입니다 - 각 저장소를 원격에서 직접 가져오는 태그입니다. 기본값은
# docker-compose.yml에 있고(보통 비워두면 됩니다), code-docker를 업데이트하면
# 검증된 태그로 같이 올라갑니다. 다른 태그나 브랜치(`main`)를 시험할 때만 적으세요 -
# 브랜치로 두면 Docker/Compose가 받은 걸 캐시하므로, 새 커밋을 반영하려면
# `--no-cache` 재빌드가 필요할 수 있습니다. router는 커밋 sha로는 안 됩니다(태그나
# 브랜치만 - docker-compose.yml의 include 주석 참고).
#ROUTER_REF=""        # qwreey/router-docker (compose include)
#DIND_REF=""          # qwreey/dind-authz-docker (code-docker-dind 빌드)
#AUTOINSTALL_REF=""   # qwreey/code-server-autoinstall (code-server 설치/패치)

# 위 셋을 로컬 체크아웃으로 바꿔 끼웁니다 - 개발할 때만. ./dev-clone.sh가 dev/에
# 받아두고 이 줄들을 출력해 줍니다. 설정하면 해당 *_REF는 무시됩니다.
#ROUTER_INCLUDE="./dev/router-docker/docker-compose.router.yml"
#DIND_CONTEXT="./dev/dind-authz-docker"
#AUTOINSTALL_SOURCE="./dev/code-server-autoinstall"

# code-docker-internal/external 두 네트워크의 enable_ipv6를 한 번에 켭니다.
# PREFIX/BUILD_CONTEXT와 마찬가지로 docker-compose.yml의 네트워크 정의에만
# 쓰이고, 컨테이너 안 환경변수는 아닙니다. 도커 엔진 자체의 ipv6 지원
# (daemon.json의 ipv6/fixed-cidr-v6 등)이 먼저 켜져 있어야 의미가 있습니다 - 엔진
# 지원 없이 이 값만 켜면 네트워크 생성이 실패합니다.
#
# 켜면 netgate(router-docker)가 IPv6이 붙어있는 걸 감지해 ip6tables로 고정 차단
# 세트(fc00::/7 ULA, fe80::/10 link-local, ::1/128 loopback) + outbound: 안의 v6
# CIDR 항목만 미러링합니다 - forwards:/bandwidth:는 미러링되지 않고,
# config.default.yaml도 아직 v4 CIDR만 지원합니다. ip6tables가 없거나 규칙 적용이
# 실패하면 `docker compose logs`에 큰 경고 블록이 반복해서 뜹니다(조용히 넘어가지
# 않음). 커버리지는 docs/egress-netgate.md의 "IPv6" 절 참고. 가장 단순하고 안전한
# 기본값은 여전히 이 값을 켜지 않는 것입니다.
#ENABLE_IPV6="false"

# Web app name
#PWA_NAME="code-docker"
#PWA_SHORT_NAME="code-docker"

# code-server 자체 manifest.json의 display 필드를 덮어씁니다(start.sh의
# apply_pwa_metadata_patch가 PWA_NAME/PWA_SHORT_NAME과 같은 방식으로 patch).
# 업스트림 원본은 "fullscreen"으로 고정되어 있지만, code-docker는 기본값을
# "standalone"으로 바꿔 patch합니다 - 일부 Android PWA 셸은 진짜 "fullscreen"일 때
# 시스템 상태바(시계 포함)와 code-server 상단 메뉴까지 함께 숨겨져서, 쓸어내려
# 상태바를 꺼내야만 메뉴가 같이 나타나는 문제가 있기 때문입니다. 진짜 풀스크린을
# 원하면 "fullscreen"으로 opt-in 하세요. 브라우저는 "홈 화면에 추가" 하는 순간에만
# manifest를 읽으므로, 이미 설치된 앱은 값을 바꿔도 소급 적용되지 않습니다 - 삭제
# 후 다시 추가해야 반영됩니다.
#PWA_DISPLAY_MODE="fullscreen"

# 호스트에 마운트할 볼륨 경로. 기본은 저장소 안 ./data/code, ./data/sshd,
# ./data/dind 등 - 개발용 소스 체크아웃(dev/dind-authz-docker/, dev/router-docker/,
# ...)과 헷갈리지 않도록 런타임 데이터는 전부 data/ 아래 모아둡니다. 다른
# 위치(다른 디스크, 여러 인스턴스 간 공유 등)를 쓰고 싶을 때만 바꾸세요.
#DIND_VOLUME="./data/dind"
#HOME_VOLUME="./data/code"
#SSHD_VOLUME="./data/sshd"
#ROUTER_VOLUME="./data/router"

# dind-authz(아래 DIND_TARGET 참고)의 실시간 conf.d 정책 디렉토리입니다. 반드시
# code-docker(HOME_VOLUME/`/code`)와 다른 경로여야 합니다 - code-docker 자신이 이
# 정책을 고칠 수 있으면 dind-authz를 켜는 의미가 없어집니다. 도커 호스트 자체에
# 파일시스템 접근 권한이 있는 사람만 이 디렉토리를 건드릴 수 있어야 합니다.
#DIND_AUTHZ_VOLUME="./data/dind-authz"

# Timezone for all processes (glibc reads this directly via tzdata, already
# installed - no /etc/localtime symlink needed). Empty means UTC, e.g. "Asia/Seoul".
# Named CODE_TZ, not TZ - entrypoint.sh re-exports it as the real TZ once the
# container starts: keeping the .env-side name off TZ means your own shell's TZ (if
# exported) can never silently outrank this the way Compose's ${VAR} otherwise would.
#CODE_TZ=""

# Locale (glibc LANG format, e.g. "ko_KR.UTF-8"). Same CODE_-prefixed/
# entrypoint-re-exported deal as CODE_TZ. Left unset - the base image already
# behaves reasonably (C.UTF-8). Anything beyond that needs locale-gen at build time
# (see build.*.sh override), which this image doesn't do by default.
#CODE_LANG=""

# Uses the internal-only "dind" alias, not the plain "code-docker-dind" service
# name - dind only listens on its code-docker-internal IP, and if
# code-docker-external is ever restored on code-docker (see NETGATE_ENABLED) the
# bare service name becomes ambiguous (registered in both networks' DNS zones).
# Only change this to talk to a different (or external) docker daemon.
#DOCKER_HOST="tcp://dind:2375"

# dind가 실제로 빌드/실행할 Dockerfile 스테이지입니다.
#   dind        - 보호 없음
#   dind-authz  - 기본값. dind가 만드는 컨테이너에 privileged, 허용 목록 밖 CapAdd,
#     seccomp/apparmor 비활성화, pid/network/ipc/cgroupns=host, 디바이스 패스스루,
#     /code 밖 bind mount 소스를 거부하는 authz 플러그인을 내장. 설계는
#     dind-authz-docker의 .claude/dind-authz-plan.md 참고.
#   dind-authz-remap - dind-authz에 더해 userns-remap까지 적용(컨테이너의 root가
#     호스트에서는 비특권 UID로 매핑). 기본값 아님 - LXC 등 중첩 가상화 호스트와
#     궁합이 안 좋을 수 있고, /code 아래 bind mount 쓰기가 기본적으로 막힙니다
#     (named volume을 쓰거나 대상 디렉토리 소유권을 미리 옮겨야 함) -
#     docs/tips/dind.md의 "추가 경화" 절 참고.
#DIND_TARGET="dind-authz"

# code-docker/code-docker-dind/code-docker-router 각 컨테이너의 CPU/메모리
# 상한입니다 - 컨테이너 안 프로세스가 호스트 자원을 무제한 소비하는 걸 막기 위한
# 것으로, docker-compose.yml의 deploy.resources.limits로 반영됩니다.
#
# 기본값은 전부 "0" = 제한 없음(0이면 deploy.resources.limits 블록 자체가
# 비워져서 나갑니다). CPU는 코어 개수(소수점 가능), 메모리는 단위 접미사 포함
# 문자열입니다. 예: code-docker를 4코어/4GB로 제한하려면
#   CODE_CPU_LIMIT="4"
#   CODE_MEM_LIMIT="4g"
#CODE_CPU_LIMIT="0"
#CODE_MEM_LIMIT="0"
# 중첩 컨테이너(redis, postgres 등)를 포함해 dind 데몬 전체가 공유하는 상한입니다 -
# dind 안 컨테이너 하나하나가 아니라 dind 자체의 cgroup에 적용됩니다.
#DIND_CPU_LIMIT="0"
#DIND_MEM_LIMIT="0"
# router는 host 80번 포트를 직접 받는 인터넷 대면 컨테이너이므로, 외부
# 플러딩/DoS가 호스트 자원까지 잠식하지 않도록 이 값도 같이 설정하세요.
#ROUTER_CPU_LIMIT="0"
#ROUTER_MEM_LIMIT="0"

# tailscale, Dev Proxy 노출 정책, router-manager 자체 비밀번호, tinyauth 등
# router 전용 기능 설정은 router-docker의 example-env.router로 옮겨졌습니다 - router가
# 태그로 고정된 원격 참조라 이 체크아웃 안에는 없고, `ootb.sh`가 핀된 태그 기준으로
# 받아 .env.router로 저장해줍니다(위 "코어 의존물의 버전 핀" 참고) - 이 파일과
# 별도로 `router-manager --env-migrate`로 마이그레이션됩니다. 여기 남은
# ALLOWED_HOSTS류는 code-docker와 값을 공유하기 때문에 그대로 남아있습니다.

# Dev Proxy's internal Caddy instance runs on router - only router itself reads
# these, code-docker's nginx never proxies to Caddy (router's own nginx does, over a
# unix socket, regardless of CADDY_ADAPTER_PORT - see docs/dev-proxy.md).
# CADDY_ADAPTER_PORT has no default - leave it unset to keep caddy-adapter
# unix-socket-only, or set it to also bind a TCP port (docs/dev-proxy.md's
# direct-publish alternative; you'd then need to add `ports:` for it yourself too).
#CADDY_ADAPTER_ENABLED="true"
#CADDY_ADAPTER_PORT=

# router의 nginx `location /` 캐치올(그 어떤 다른 위치와도 안 겹치는 요청)이
# 최종적으로 어디로 가는지 - caddy-adapter를 거쳐 이 값으로 reverse_proxy됩니다.
# 기본값은 code-docker 자신(zero-config 상태 유지)이지만, router는 뒤에 뭐가
# 있는지 몰라도 되므로 다른 컨테이너/주소로 자유롭게 바꿀 수 있습니다.
#DEFAULT_UPSTREAM="code-docker:80"

# In-container nginx (config/nginx/nginx.default.conf) access_log verbosity:
#   errors - only log non-2xx/3xx responses (via an nginx map/if on
#     $status), so routine traffic doesn't flood `docker compose logs`.
#   all - log every request, combined format (the old behavior).
#NGINX_LOG_LEVEL="errors"

# code-server's actual bind address, default "127.0.0.1:8080" - loopback, because
# the in-container nginx is the only thing meant to reach it (code-server has no
# login). code-runner.default.sh passes this as a --bind-addr CLI arg, overriding
# config.yaml, so this env var is the supported way to change it; nginx's upstream
# follows it automatically (nginx-service.default.sh).
#CODE_SERVER_BIND_ADDR="127.0.0.1:8080"

# code-server's own port-proxy routes (/proxy/<port>/, /absproxy/<port>/, and the
# *.<proxy-domain> variants) are DISABLED by default - set by
# code-server-autoinstall's start.sh (CS_DISABLE_PROXY is code-server's own env var,
# defaulted to 1), not by code-docker, which just passes this value through.
#
# Those routes proxy to *any* port listening inside this container, guarded by
# nothing but code-server's own auth - `auth: none` here (docs/security-login.md).
# Left on, anything that can reach code-server can reach every port inside the
# container, including whatever VS Code's PORTS tab auto-forwards. Expose what you
# actually want through router's Dev Proxy / App Routes instead (docs/dev-proxy.md,
# docs/app-routes.md), which have their own exposure policy and auth.
#
# Set 0 (anything not matching /^(1|true)$/) to restore upstream behavior. Can only
# be changed here, not in code-config.*.yaml: code-server reads any boolean key
# present there as true, so `disable-proxy: false` there would still disable it.
#
# Gates the proxy ROUTES only - VS Code's workbench still auto-detects and forwards
# ports, so the PORTS tab keeps showing up, just unreachable. That half is the
# `remote.autoForwardPorts` workbench setting, seeded false via
# config/code/settings.default.json - a container started before that default
# existed already has a settings.json and won't have it touched (the startup log
# says so and names the key).
#CS_DISABLE_PROXY="1"

# code-server 버전 고정. 비워두면(기본) 컨테이너가 뜰 때마다(1시간에 한 번까지)
# 최신 릴리스로 자동 업데이트합니다. 새 버전이 문제를 일으킬 때 "4.109.2"처럼
# 정확한 버전을 적어 묶어두세요. 다운로드가 실패하면 설치된 버전이 그대로 유지됩니다.
#CODE_SERVER_VERSION=""

# code-docker's built-in webmanager extension for code-server: webmanager
# terminal sessions (and any other webmanager tab) as editor tabs and in the
# bottom panel's "webmanager" tab. Installed automatically and kept at this
# image's build on every start - an uninstall from the Extensions view is
# undone at the next start. "false" removes it and keeps it removed.
# Needs code-server over HTTPS (or localhost); see docs/webmanager.md.
#CODE_WEBMANAGER_EXTENSION="true"

# Comma-separated allowlist of Host header values the in-container nginx will
# accept on port 80 (e.g. "code.yaeji.moe" or "code.yaeji.moe, 192.168.1.50"), no
# scheme/port. Empty (default) disables the check, any Host accepted.
#
# Best-effort backstop against incidentally reaching this container's
# directly-published port 80 without going through your intended reverse proxy
# (e.g. an internet scanner hitting the host IP directly) - NOT spoof-proof, since
# Host is a client-controlled header an attacker who knows your domain can set.
#ALLOWED_HOSTS=""

# webmanager의 File share(WebDAV) 전용 nginx 리스너 포트. 기본 82. 이 포트에서는
# /webdav 외 모든 경로가 404입니다. router vhost로 공유에 전용 호스트네임을 주기
# 위해 존재합니다:
#
#   ROUTER_VHOST_WEBDAV="dav.example.com=code-docker:82"
#
# vhost의 upstream은 경로 없는 host[:port]라서, 포트 80을 가리키면 그
# 호스트네임에 code-server까지 같이 노출됩니다 - 그래서 별도 포트입니다. 이
# 컨테이너는 호스트 포트를 게시하지 않으므로 이 포트는 code-docker-internal
# 안에서만 닿습니다. 공유 자체가 기본 꺼짐이라 webmanager의 File share 탭에서
# 켜기 전까지는 404만 돌려줍니다. 자세한 건 docs/tips/webdav.md.
#NGINX_WEBDAV_PORT="82"

# Comma-separated IP/CIDR list of upstream reverse proxies (e.g. your external
# Caddy's container/host IP) whose X-Forwarded-For header nginx should trust to
# determine the real client IP - otherwise $remote_addr is just the proxy's own
# IP. Empty (default) disables this.
#TRUSTED_PROXIES=""

# vector's own internal diagnostic log level (startup/healthcheck/file-watch
# chatter). Doesn't touch the actual log pipeline data it carries (other programs'
# re-emitted stdout, /code/.local/share/code-docker/vector/logs/*.jsonl) - see
# vector.default.toml for that. "warn" mirrors nginx's own `error_log ... warn;`
# above; "error" for quieter, "info"/"debug" for more chatter.
#VECTOR_LOG_LEVEL="warn"

# Path `webmanager --env-migrate`/the startup version-mismatch check reads the
# current example-env.webmanager template from. Left unset to use the image's own
# copy. Not settable via .env.webmanager itself - that file is what gets migrated
# using this template, so pointing to it from inside would be self-referential.
# To enforce your own org policy (e.g. #!important-forced keys) across multiple
# instances, bind-mount a custom template over this path instead - add under
# docker-compose.yml's code-docker `volumes:`:
#   - ./custom-example-env.webmanager:/etc/code-docker/webmanager/example-env.webmanager:ro
#WEBMANAGER_ENV_TEMPLATE_PATH="/etc/code-docker/webmanager/example-env.webmanager"

# 바로 위 WEBMANAGER_ENV_TEMPLATE_PATH와 같은 패턴이지만 router-manager의
# example-env.router 쪽입니다. 마찬가지로 .env.router 자신에는 설정할 수
# 없습니다(자기참조가 되므로) - 이 값은 이 파일(.env)에서만 설정합니다. 조직 커스텀
# 템플릿을 강제하려면 이 경로에 볼륨을 바인드 마운트하세요 -
# docker-compose.yml의 code-docker-router `volumes:`에 아래처럼 추가:
#   - ./custom-example-env.router:/etc/router/example-env.router:ro
#ROUTER_ENV_TEMPLATE_PATH="/etc/router/example-env.router"

# 아웃바운드 네트워크 격리(egress lockdown) 설정입니다. 사용자 문서
# docs/egress-netgate.md, 설계 배경 .claude/archive/egress-netgate-plan-done.md 참고.
# code-docker/dind는 code-docker-external에 직접 붙지 않고, netinit-docker(호스트측
# 라벨 기반 에이전트, .claude/archive/netinit-docker-plan-done.md 참고) 및 dind
# 자신이 심어주는 기본 라우트를 통해서만 code-docker-router를 거쳐 나갑니다.
#
# "false"로 끄면 dind의 라우팅 루프, code-docker의 entrypoint 대기 가드(아래
# NETINIT_WAIT의 기본값도 이 값을 따라갑니다), router 자신의 방화벽 적용 루프,
# netinit-docker의 NETINIT_DOCKER_ENABLED(docker-compose.yml이 이 값을 그대로
# 넘겨줍니다)가 전부 idle 상태가 됩니다 - router 컨테이너 자체나
# DNS/tailscale/Dev Proxy/tinyauth 등 다른 기능은 정상 동작합니다. DOCKER-USER
# 예외는 이와 무관하게 계속 유지됩니다.
#
# networks:의 code-docker-external 제거나 ports:의 위치(code-docker-router에
# 있음)는 되돌리지 않습니다 - Compose는 네트워크/포트 설정을 런타임 환경변수로
# 조건화할 수 없으므로, 완전히 예전 토폴로지로 되돌리려면 docker-compose.yml에서
# code-docker/code-docker-dind의 networks:에 `code-docker-external: {}`를 직접
# 추가하고 code-docker의 ports:도 복구해야 합니다(`- 80:80`, `- 22:22`) - 정확한
# 절차는 docs/egress-netgate.md의 "당장 인터넷이 필요하다면" 절 참고.
#NETGATE_ENABLED="true"

# code-docker가 "바깥에서 누가 내 기본 라우트를 심어줄 때까지" 기다릴지 여부와 그
# 타임아웃(초)입니다. netinit-docker는 컨테이너가 이미 뜬 뒤에야 동작할 수 있으므로
# (호스트측 에이전트가 SandboxKey로 netns에 들어가는 구조), 그 사이 code-docker가
# 라우트 없이 네트워크를 쓰는 창을 막는 게이트입니다. 타임아웃되면 non-zero로
# 종료해 restart: unless-stopped가 다시 시도하게 합니다(fail-closed).
#
# 이름이 NETGATE_*가 아니라 NETINIT_*인 이유: 이 동작의 주인은 범용 도구인
# netinit-docker이고, roblox-studio-docker 등 다른 클라이언트도 같은 이름 쌍을
# 씁니다(env 이름은 구현자가 아니라 소유자를 따릅니다). NETGATE_ENABLED는 "이
# 배포가 router를 거쳐 나가는가"라는 code-docker 자신의 스위치로 남습니다.
#
# 기본값은 NETGATE_ENABLED를 따라갑니다 - 아무것도 설정하지 않으면 기다리고,
# NETGATE_ENABLED="false"만 설정해도 이 대기까지 같이 꺼집니다. netgate는 켜둔 채
# 대기만 끄고 싶은 특수한 경우에만 NETINIT_WAIT="false"를 따로 씁니다.
#NETINIT_WAIT=""
#NETINIT_WAIT_TIMEOUT="60"

# code-docker/code-docker-dind가 라우터를 찾을 때 쓰는 호스트네임입니다
# (entrypoint.sh/dind-entrypoint.sh가 이 값으로 getent hosts를 호출).
# code-docker-netinit-docker는 이 값을 쓰지 않습니다 - `netinit.gateway` 라벨이
# 컨테이너 이름을 직접 받습니다. code-docker-router 서비스 자신의
# code-docker-internal 별칭도 이 값을 그대로 씁니다 - docker-compose.yml 한
# 곳에서 같은 변수를 참조하므로 둘이 어긋날 일은 없습니다. PREFIX가 이미 네트워크
# 자체를 인스턴스별로 분리해주므로 여러 인스턴스를 한 호스트에 띄우는 것만으로는
# 바꿀 필요가 없습니다 - docker-compose.yml을 직접 손대지 않고 라우터 별칭
# 이름을 다른 값으로 바꾸고 싶을 때만 설정하세요.
#ROUTER_HOSTNAME="router"

# router의 internal-source deny(/exports/, router-manager 관리 API)가 참조하는
# "울타리 안쪽" 네트워크의 CIDR입니다. 비워두면 router가 자기 라우팅 테이블에서
# 직접 감지합니다(nginx-service.default.sh의 detect_internal_subnets) - 기본
# 경로가 걸린 인터페이스(code-docker-external)를 제외한 **모든** 연결 네트워크가
# 대상이므로 EXTRA_INCLUDE로 붙은 sibling 프로젝트의 네트워크도 자동 포함됩니다.
# code-docker-internal은 subnet이 고정되어 있지 않고 Docker가 매번 자동
# 할당하므로, 감지가 곧 실제 값입니다. 직접 설정해야 하는 경우는 그 전제가 깨지는
# 드문 상황뿐이며, 여러 개면 쉼표로 구분합니다. router 시작 로그의
# "internal-source deny covers:" 줄로 실제 적용된 목록을 확인할 수 있습니다.
#ROUTER_INTERNAL_SUBNET=""

# code-docker-router가 호스트에 퍼블리시하는 80번 포트의 바인딩 주소/포트입니다
# (docker-compose.yml ports: 참고). 기본은 "0.0.0.0:80"으로 모든 인터페이스에
# 바인딩합니다 - 특정 호스트 IP에만 바인딩하고 싶을 때(예: 여러 NIC 중 하나만,
# 또는 다른 서비스가 이미 0.0.0.0:80을 쓰고 있을 때) ROUTER_HTTP_BIND를,
# 80이 아닌 다른 호스트 포트를 쓰고 싶을 때 ROUTER_HTTP_PORT를 설정하세요.
# 컨테이너 내부 포트(80, nginx)는 바뀌지 않습니다.
#ROUTER_HTTP_BIND="0.0.0.0"
#ROUTER_HTTP_PORT="80"
